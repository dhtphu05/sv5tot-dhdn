# ============================================================================
# 5TOT ĐÀ NẴNG — PRODUCTION BACKEND V2 ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# Runtime Environment ("development" | "test" | "staging" | "production")
NODE_ENV="development"

# Database Execution Mode ("online" | "offline")
# Đặt "online" để kết nối trực tiếp tới Neon Database và Cloudflare R2.
BACKEND_DATABASE_MODE="online"

# HTTP Listener Port (Cloud Run injects PORT=8080 or port 3001 for dev)
PORT="3001"

# API Versioned Prefix
API_PREFIX="/api/v2"

# ============================================================================
# 1. NEON DATABASE (SERVERLESS POSTGRESQL 16+)
# ============================================================================

# Neon Pooled Connection String (dùng cho ứng dụng runtime - có hậu tố `-pooler` và `?pgbouncer=true&connect_timeout=15&sslmode=require`)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon Direct Connection String (dùng cho Prisma Migrate / Schema Push - KHÔNG có `-pooler`)
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Isolated Integration Test Database URL (tuỳ chọn cho chạy test tích hợp)
TEST_DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb_test?sslmode=require"

# ============================================================================
# 2. CLOUDFLARE R2 OBJECT STORAGE (MINH CHỨNG ẢNH JPG/PNG/WEBP & TỆP PDF)
# ============================================================================

# Cloudflare Account ID (lấy tại Cloudflare Dashboard -> R2 Object Storage -> Account ID)
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# R2 S3 API Token Credentials (lấy tại R2 -> Manage R2 API Tokens -> Object Read & Write)
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"

# Tên Bucket R2 lưu trữ minh chứng riêng tư (Private Bucket)
R2_BUCKET_NAME="5tot-danang-private-evidence"

# Tuỳ chọn: Endpoint S3 của R2 (mặc định tự suy ra từ https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT="https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"

# Thời hạn hiệu lực của Presigned URL (giây)
R2_PRESIGNED_PUT_TTL_SECONDS="300"
R2_PRESIGNED_GET_TTL_SECONDS="120"

# ============================================================================
# 3. ZERO-TRUST JWT, CORS & HẠ TẦNG VẬN HÀNH
# ============================================================================

JWT_ACCESS_SECRET="dev-access-token-secret-for-offline-be2a-only-minimum-256-bit-key-testing"
JWT_ACCESS_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="604800"
REFRESH_TOKEN_PEPPER="dev-refresh-pepper-for-offline-be2a"

# CORS Origin Allowlist (Comma-separated exact origins, NO wildcard in production)
CORS_ALLOWED_ORIGINS="https://api-sv5tot-dhdn.lcdkhoacntt-dut.page,https://sv5tot-dhdn.lcdkhoacntt-dut.page,http://localhost:3000,http://localhost:5173"

# Structured Log Level ("debug" | "info" | "warn" | "error")
LOG_LEVEL="info"

# Maximum Inbound JSON Request Body Size
MAX_BODY_SIZE_BYTES="1048576"

# Database Connection & Query Limits
DB_CONNECT_TIMEOUT_MS="5000"
DB_SLOW_QUERY_WARN_MS="200"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="3000"

